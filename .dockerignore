# Keep the build context to what `go build` actually reads. Without this the
# context ships .git and the locally built binary in bin/, tens of megabytes
# that are re-uploaded to the daemon on every build and end up in no layer.
.git
.github
dist/
bin/
*.db
*.db-wal
*.db-shm
.DS_Store
node_modules/
graphify-out/

# Mounted at runtime by docker-compose.dev.yml, never copied into the image:
# shipping them would invalidate every build layer whenever a fixture changes.
docker/dev/out/
docker/dev/fixtures/
