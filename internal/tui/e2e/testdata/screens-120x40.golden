     Preview endpoint returns 503 under load                                                                            
                                                                                                                        
    Restart the preview worker pool and watch memory.                                                                   
                                                                                                                        
      func restart(pool *Pool) error {                                                                                  
          if err := pool.Drain(); err != nil {                                                                          
              return fmt.Errorf("drain: %w", err)                                                                       
          }                                                                                                             
          return pool.Start()                                                                                           
      }                                                                                                                 
                                                                                                                        
                                                                                                                        
                                                                                                                        
